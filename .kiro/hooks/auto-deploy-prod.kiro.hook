{
  "enabled": true,
  "name": "Auto Deploy to Production",
  "description": "Automatically deploys to Vercel production when the agent completes a task, ensuring all changes go live without manual intervention.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "vercel --prod --yes",
    "timeout": 120
  }
}