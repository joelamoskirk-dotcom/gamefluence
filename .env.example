# Environment Variables for Gamefluence Platform
# Copy this file to .env.local and fill in your actual values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Gamefluence

# Founder Authentication (REQUIRED — set strong values, never commit real credentials)
FOUNDER_USERNAME=
FOUNDER_PASSWORD=
FOUNDER_MASTER_KEY=

# Stripe Configuration (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# API Keys for Integrations (Optional)
APPSFLYER_API_KEY=your_appsflyer_key
STREAMCHARTS_API_KEY=your_streamcharts_key
GOOGLE_ANALYTICS_API_KEY=your_ga_key

# Twitch API (for creator streaming data, live status, analytics)
# Register at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Database (if you add one later)
DATABASE_URL=your_database_connection_string

# Email Service (Resend — for lead gen and contact form notifications)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=admin@gamefluence.com.au


# Cron Job Secret (for Vercel Cron authentication)
CRON_SECRET=your_cron_secret_here

# S2S Attribution
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
META_PIXEL_ID=
META_ACCESS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Discord Integration
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_SECRET=

# Google Sheets Database
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GAMEFLUENCE_SHEET_ID=
MOBILEYES_SHEET_ID=

# PostHog Analytics (separate project for Gamefluence)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
